model Area {
  id           String    @id @default(uuid())
  name         String
  code         String    @unique

  zoneId       String
  substationId String?
  feederId     String?

  address      String?
  latitude     Float?
  longitude    Float?

  isActive     Boolean   @default(true)
  deletedAt    DateTime?

  zone         Zone      @relation(fields: [zoneId], references: [id])
  substation   Substation? @relation(fields: [substationId], references: [id])
  feeder       Feeder?   @relation(fields: [feederId], references: [id])

  schedules    LoadSheddingSchedule[]
  outages      Outage[]

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([zoneId])
  @@index([substationId])
  @@index([feederId])
  @@index([name])

  @@map("areas")
}