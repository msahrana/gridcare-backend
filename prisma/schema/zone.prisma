model Zone {
  id          String        @id @default(uuid())
  name        String
  code        String        @unique
  description String?
  isActive    Boolean       @default(true)
  deletedAt   DateTime?

  substations Substation[]
  areas       Area[]

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([name])

  @@map("zone")
} 