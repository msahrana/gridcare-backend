model Feeder {
  id           String      @id @default(uuid())
  name         String
  code         String      @unique
  substationId String
  status       String?
  deletedAt    DateTime?

  substation   Substation  @relation(fields: [substationId], references: [id])
  areas        Area[]

  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([substationId])

  @@map("feeders")
}