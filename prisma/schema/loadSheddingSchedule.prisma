model LoadSheddingSchedule {
  id          String         @id @default(uuid())

  areaId      String
  title       String
  description String?

  startTime   DateTime
  endTime     DateTime

  status      ScheduleStatus @default(DRAFT)

  createdById String

  area        Area           @relation(fields: [areaId], references: [id])

  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  deletedAt   DateTime?

  @@index([areaId])
  @@index([startTime])
  @@index([status])

  @@map("load_shedding_schedules")
}