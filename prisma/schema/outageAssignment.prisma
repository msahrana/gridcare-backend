model OutageAssignment {
  id           String           @id @default(uuid())
  outageId     String
  technicianId String
  assignedById String

  status       AssignmentStatus @default(ASSIGNED)

  assignedAt   DateTime         @default(now())
  acceptedAt   DateTime?
  startedAt    DateTime?
  completedAt  DateTime?

  outage       Outage     @relation(fields: [outageId], references: [id])
  technician   Technician @relation(fields: [technicianId], references: [id])
  assignedBy   User       @relation("AssignmentCreator", fields: [assignedById], references: [id])

  @@index([outageId])
  @@index([technicianId])
  @@index([assignedById])
  @@index([status])
  @@unique([outageId, technicianId])

  @@map("outage_assignments")
}